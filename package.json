{
  "name": "planning-serein-next",
  "version": "1.0.0",
  "private": true,
  "description": "Planning mensuel Next.js, comptes autonomes et Neon PostgreSQL.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:migrate": "prisma migrate deploy",
    "admin:create": "node scripts/create-admin.mjs",
    "password:reset": "node scripts/reset-password.mjs",
    "test": "node --import ./tests/alias.mjs --test tests/*.test.mjs",
    "check": "node scripts/check-structure.mjs",
    "test:http": "node scripts/smoke-http.mjs",
    "format": "prettier --write \"src/**/*.js\" \"src/**/*.jsx\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.mjs\"",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:migrations": "node scripts/test-prisma-migrations.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.0.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.2.18",
    "prettier": "3.9.10",
    "prisma": "7.10.1"
  }
}
