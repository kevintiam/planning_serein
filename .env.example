# Copier ce fichier vers .env.local. Ne jamais committer les vraies valeurs.
# URL POOLÉE fournie par Neon > Connect ; conserve sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# URL DIRECTE Neon, conseillée pour les migrations et les scripts CLI.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
# Origine exacte du site, sans slash final ; HTTPS en production.
APP_URL=http://localhost:3000
