// Client JavaScript : conserve les composants JSX et les scripts Node existants.
generator client {
  provider = "prisma-client-js"
}

// L'URL CLI est dans prisma.config.ts ; le runtime utilise l'adaptateur PostgreSQL.
datasource db {
  provider = "postgresql"
}

// Les noms des tables/colonnes existantes sont conservés pour la reprise des données.
model Team {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  invite_hash String   @unique @db.Char(64)
  created_at  DateTime @default(now()) @db.Timestamptz
  users       User[]
  tasks       Task[]
  schedules   Schedule[]
  @@map("teams")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  team_id       String   @db.Uuid
  name          String   @db.VarChar(100)
  email         String   @unique @db.VarChar(254)
  password_hash String
  // La contrainte SQL role IN ('admin','participant') reste dans la migration.
  role          String   @db.VarChar(20)
  created_at    DateTime @default(now()) @db.Timestamptz
  team          Team     @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sessions      Session[]
  declarations  Declaration[]
  absences      Absence[]
  tasks         Task[]
  @@unique([id, team_id])
  @@map("users")
}

model Session {
  token_hash String   @id @db.Char(64)
  user_id    String   @db.Uuid
  expires_at DateTime @db.Timestamptz
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([user_id], map: "sessions_user_idx")
  @@index([expires_at], map: "sessions_expiry_idx")
  @@map("sessions")
}

model Declaration {
  user_id      String   @db.Uuid
  team_id      String   @db.Uuid
  month        String   @db.Char(7)
  confirmed_at DateTime? @db.Timestamptz
  updated_at   DateTime @default(now()) @db.Timestamptz
  user         User     @relation(fields: [user_id, team_id], references: [id, team_id], onDelete: Cascade, onUpdate: NoAction)
  @@id([user_id, month])
  @@map("declarations")
}

model Absence {
  user_id String @db.Uuid
  team_id String @db.Uuid
  day     DateTime @db.Date
  user    User @relation(fields: [user_id, team_id], references: [id, team_id], onDelete: Cascade, onUpdate: NoAction)
  @@id([user_id, day])
  @@index([team_id, day], map: "absences_team_day_idx")
  @@map("absences")
}

model Task {
  id             String @id @default(uuid()) @db.Uuid
  team_id        String @db.Uuid
  participant_id String @db.Uuid
  day            DateTime @db.Date
  start_time     DateTime @db.Time(6)
  end_time       DateTime @db.Time(6)
  title          String @db.VarChar(100)
  created_at     DateTime @default(now()) @db.Timestamptz
  team           Team @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  participant    User @relation(fields: [participant_id, team_id], references: [id, team_id], onDelete: NoAction, onUpdate: NoAction)
  @@index([team_id, day], map: "tasks_team_day_idx")
  @@map("tasks")
}

model Schedule {
  team_id      String @db.Uuid
  month        String @db.Char(7)
  published_at DateTime? @db.Timestamptz
  team         Team @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([team_id, month])
  @@map("schedules")
}

model RateLimit {
  key      String @id @db.Char(64)
  attempts Int
  reset_at DateTime @db.Timestamptz
  @@map("rate_limits")
}
